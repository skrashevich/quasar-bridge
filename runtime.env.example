# Copy to runtime.env (ignored by Git), chmod 600, and supply real values.
# Optional: leave empty to use Yandex for home requests.
QUASAR_HOME_MCP_URL=
# QUASAR_HOME_MCP_URL=https://home.example.invalid/mcp
# Optional Home Assistant conversation API. Leave the URL empty to use only the MCP planner.
# The token is a long-lived access token. Do not put it in config.json.
# QUASAR_HOME_ASSISTANT_URL=http://home.example.invalid:8123
# QUASAR_HOME_ASSISTANT_AGENT_ID= ignored; the voice pipeline selects the agent
QUASAR_HOME_ASSISTANT_TOKEN=
QUASAR_LLM_API_KEY=
# Optional overrides for JSON deployment settings:
# QUASAR_LISTEN=localhost:8443
# QUASAR_UPSTREAM=wss://uniproxy.alice.yandex.net/uni.ws
# QUASAR_MODE=hybrid
# QUASAR_LLM_BASE_URL=https://llm.example.invalid/v1
# QUASAR_LLM_MODEL=your-model
# QUASAR_LLM_SYSTEM_PROMPT='Ты находишься в комнате «Зал» в городе «Москва». Если пользователь не указал комнату, считай, что речь идёт о Зале.'
# QUASAR_LLM_API=responses
# QUASAR_LLM_REASONING_EFFORT=low
# QUASAR_TLS_CERT=certs/server.pem
# QUASAR_TLS_KEY=certs/server.key
# QUASAR_ALLOWED_IPS=SPEAKER_IP,ADMIN_IP
# QUASAR_HOME_WARM_AREA=Office
