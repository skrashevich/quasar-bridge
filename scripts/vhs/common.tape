# Run from the repository root. See scripts/vhs/README.md.
Require bash
Set Shell bash
Set FontFamily "Menlo"
Set FontSize 20
Set Width 1280
Set Height 820
Set Padding 24
Set Margin 16
Set MarginFill "#090d16"
Set BorderRadius 14
Set WindowBar Colorful
Set Theme "Catppuccin Mocha"
Set Framerate 12
Set TypingSpeed 22ms
Set CursorBlink false
Set WaitTimeout 180s
Env TERM "xterm-256color"
Env NO_COLOR ""
